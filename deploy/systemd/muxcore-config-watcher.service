[Unit]
Description=MuxCore Module - Config Watcher
After=network-online.target muxcored.service
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/config-watcher \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id config-watcher
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

Environment=CONFIG_WATCHER_GRPC_ADDR=:9611

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/config-watcher

[Install]
WantedBy=multi-user.target
