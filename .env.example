# MuxCore Config Watcher — Environment Variables
# Copy to .env and adjust for your environment.

# Core connection
# MUXCORE_GRPC_ADDR=localhost:9090
# MUXCORE_INSECURE_DISABLE_TLS=true

# Module identity
# MUXCORE_MODULE_ID=config-watcher

# Module-specific settings
# CONFIG_WATCHER_GRPC_ADDR=:9614
# CONFIG_WATCHER_STREAM_BUFFER=16
# CONFIG_WATCHER_REGISTRY_SYNC_DELAY=2s
# CONFIG_WATCHER_MODULE_TOKEN=
